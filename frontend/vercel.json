{
  "rewrites": [
    {
      "source": "/destinations/:slug",
      "destination": "/destination.html?id=:slug"
    },
    {
      "source": "/admin-login/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/login/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin-dashboard/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|mjs|png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
