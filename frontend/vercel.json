{
  "rewrites": [
    {
      "source": "/destinations/:slug",
      "destination": "/destination.html?id=:slug"
    },
    {
      "source": "/admin-login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin-login/",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/login/",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/dashboard/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin-dashboard/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/destinations",
      "destination": "/admin/destinations/index.html"
    },
    {
      "source": "/admin/destinations/",
      "destination": "/admin/destinations/index.html"
    },
    {
      "source": "/admin/destinations/edit",
      "destination": "/admin/destinations/edit.html"
    },
    {
      "source": "/admin/destinations/edit/",
      "destination": "/admin/destinations/edit.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mjs",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
