rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** CMS write access — requires admins/{uid} with admin privilege */
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == 'admin'
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true
        );
    }

    function isContentCollection(name) {
      return name in [
        'hero',
        'about',
        'contact',
        'socials',
        'settings',
        'destinations',
        'gallery',
        'weatherCards'
      ];
    }

    // Admin allowlist — signed-in user may read/write ONLY their own admins/{uid} doc
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
      allow list: if false;
    }

    // Global CMS pointer — public read (which Cloudinary JSON is live), admin write on save
    match /cmsMeta/{document} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Public CMS read + backup: own admins/{uid} readable when signed in
    match /{collection}/{document} {
      allow read: if isContentCollection(collection)
        || (isSignedIn() && collection == 'admins' && request.auth.uid == document);
      allow create, update, delete: if isContentCollection(collection) && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
