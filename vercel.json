{
  "redirects": [
    { "source": "/destinations.html", "destination": "/destinations", "permanent": true },
    {
      "source": "/destinations/arusha",
      "destination": "/destinations/7-day-tanzania-wilderness-safari",
      "permanent": true
    },
    {
      "source": "/destinations/lake-manyara",
      "destination": "/destinations/7-day-off-peak-tanzania-safari",
      "permanent": true
    },
    {
      "source": "/destinations/ngorongoro",
      "destination": "/destinations/6-day-northern-tanzania-safari",
      "permanent": true
    },
    {
      "source": "/destinations/ruaha",
      "destination": "/destinations/5-day-serengeti-great-migration-safari",
      "permanent": true
    },
    {
      "source": "/destinations/tarangire",
      "destination": "/destinations/5-day-wildebeest-calving-safari",
      "permanent": true
    },
    {
      "source": "/destination.html",
      "has": [{ "type": "query", "key": "id", "value": "arusha" }],
      "destination": "/destinations/7-day-tanzania-wilderness-safari",
      "permanent": true
    },
    {
      "source": "/destination.html",
      "has": [{ "type": "query", "key": "id", "value": "lake-manyara" }],
      "destination": "/destinations/7-day-off-peak-tanzania-safari",
      "permanent": true
    },
    {
      "source": "/destination.html",
      "has": [{ "type": "query", "key": "id", "value": "ngorongoro" }],
      "destination": "/destinations/6-day-northern-tanzania-safari",
      "permanent": true
    },
    {
      "source": "/destination.html",
      "has": [{ "type": "query", "key": "id", "value": "ruaha" }],
      "destination": "/destinations/5-day-serengeti-great-migration-safari",
      "permanent": true
    },
    {
      "source": "/destination.html",
      "has": [{ "type": "query", "key": "id", "value": "tarangire" }],
      "destination": "/destinations/5-day-wildebeest-calving-safari",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/frontend/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/destinations", "destination": "/frontend/destinations.html" },
    {
      "source": "/destinations/:slug",
      "destination": "/frontend/destination.html?id=:slug"
    },
    {
      "source": "/admin-login/",
      "destination": "/frontend/admin/login.html"
    },
    {
      "source": "/admin-login",
      "destination": "/frontend/admin/login.html"
    },
    {
      "source": "/admin/login/",
      "destination": "/frontend/admin/login.html"
    },
    {
      "source": "/admin/login",
      "destination": "/frontend/admin/login.html"
    },
    {
      "source": "/admin/dashboard/",
      "destination": "/frontend/admin/dashboard.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/frontend/admin/dashboard.html"
    },
    {
      "source": "/admin-dashboard/",
      "destination": "/frontend/admin/dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/frontend/admin/dashboard.html"
    },
    {
      "source": "/admin/",
      "destination": "/frontend/admin/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/dashboard.html"
    },
    {
      "source": "/admin/destinations/",
      "destination": "/frontend/admin/destinations/index.html"
    },
    {
      "source": "/admin/destinations",
      "destination": "/frontend/admin/destinations/index.html"
    },
    {
      "source": "/admin/destinations/edit/",
      "destination": "/frontend/admin/destinations/edit.html"
    },
    {
      "source": "/admin/destinations/edit",
      "destination": "/frontend/admin/destinations/edit.html"
    },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ],
  "headers": [
    {
      "source": "/frontend/(.*)\\.(css|js|mjs|png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
